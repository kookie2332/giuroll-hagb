{
  "arch": "x86",
  "data-layout": "e-m:x-p:32:32-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32-a:0:32-S32",
  "llvm-target": "i686-pc-windows-msvc",
  "target-endian": "little",
  "target-pointer-width": "32",
  "target-c-int-width": "32",
  "os": "windows",
  "env": "msvc",
  "vendor": "pc",
  "linker-flavor": "msvc",
  "linker": "rust-lld",
  "lld-flavor": "link",
  "link-self-contained": true,
  "dynamic-linking": true,
  "dll-prefix": "",
  "dll-suffix": ".dll",
  "exe-suffix": ".exe",
  "staticlib-prefix": "",
  "staticlib-suffix": ".lib",
  "target-family": ["windows"],
  "max-atomic-width": 64,
  "has-thread-local": true,
  "is-like-windows": true,
  "is-like-msvc": true,
  "panic-strategy": "unwind",
  "crt-static-respected": true,
  "crt-static-allows-dylibs": true,
  "crt-objects-fallback": false,
  "abi-return-struct-as-int": true,
  "archive-format": "coff",
  "binary-format": "coff",
  "debuginfo-kind": "pdb",
  "emit-debug-gdb-scripts": false,
  "frame-pointer": "maybe",
  "split-debuginfo": "packed",
  "supported-split-debuginfo": ["packed"],
  "supported-sanitizers": ["address"],
  "requires-uwtable": true,
  "rustc-abi": "x86-sse2",
  "pre-link-args": {
    "msvc": ["/NOLOGO", "/LARGEADDRESSAWARE", "/SAFESEH"],
    "msvc-lld": ["/NOLOGO", "/LARGEADDRESSAWARE", "/SAFESEH"]
  },
  "metadata": {
    "description": "32-bit Windows 7+ (MSVC-compatible)",
    "host_tools": true,
    "std": true,
    "tier": 3
  }
}
